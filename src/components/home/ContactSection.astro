---
import SectionHeading from "@/components/common/SectionHeading.astro";
import { siteConfig } from "@/data/site";
---

<section class="section-pad contact-section" id="contact">
  <div class="container">
    <div class="contact-panel reveal reveal-up">
      <SectionHeading
        eyebrow="Contact"
        title="Ready for UX/UI design, software developer roles, and creative collaborations."
        description="For opportunities, project conversations, or portfolio review, feel free to reach me through email, LinkedIn, or WhatsApp."
        align="center"
      />
      <div class="contact-actions">
        <a class="btn-primary-soft" href={`mailto:${siteConfig.email}`}>Email Me</a>
        <a class="text-link" href={siteConfig.linkedIn}>LinkedIn</a>
        <a class="text-link" href={siteConfig.whatsApp}>WhatsApp</a>
      </div>
    </div>
  </div>
</section>
