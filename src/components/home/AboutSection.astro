---
import SectionHeading from "@/components/common/SectionHeading.astro";
---

<section class="section-pad about-section" id="about">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-5">
        <SectionHeading eyebrow="About" title="A multimedia creative who thinks in systems, screens, and stories." />
      </div>
      <div class="col-lg-7 reveal reveal-up">
        <div class="about-copy">
          <p>
            Replace this with a concise personal introduction. The tone is designed for a designer-developer who
            combines clean interface thinking, technical implementation, and visual storytelling across media.
          </p>
          <p>
            Use this section to describe what you value, how you work, and why your mix of web development, UI/UX,
            graphic design, and motion design creates stronger digital experiences.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
