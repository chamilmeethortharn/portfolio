---
interface Props {
  image: string;
  alt: string;
}

const { image, alt } = Astro.props;
---

<figure class="mockup browser-mockup">
  <div class="browser-bar">
    <span></span><span></span><span></span>
  </div>
  <div class="mockup-screen">
    <img src={image} alt={alt} loading="lazy" />
  </div>
</figure>
