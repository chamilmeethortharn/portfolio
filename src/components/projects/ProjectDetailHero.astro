---
import type { Project } from "@/data/projects";
import BrowserMockup from "@/components/mockups/BrowserMockup.astro";
import GalleryMockup from "@/components/mockups/GalleryMockup.astro";
import LaptopMockup from "@/components/mockups/LaptopMockup.astro";
import MobileMockup from "@/components/mockups/MobileMockup.astro";
import VideoMockup from "@/components/mockups/VideoMockup.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const Mockup =
  project.mockupType === "laptop"
    ? LaptopMockup
    : project.mockupType === "mobile"
      ? MobileMockup
      : project.mockupType === "gallery"
        ? GalleryMockup
        : project.mockupType === "video"
          ? VideoMockup
          : BrowserMockup;
---

<section class="project-hero section-pad">
  <div class="container">
    <div class="row align-items-center g-5">
      <div class="col-lg-5 reveal reveal-up">
        <a class="text-link back-link" href="/#works">Back to Works</a>
        <p class="eyebrow">{project.category}</p>
        <h1>{project.title}</h1>
        <p class="lead">{project.shortDescription}</p>
      </div>
      <div class="col-lg-7 reveal reveal-fade">
        <div class="project-hero-media">
          <Mockup image={project.thumbnail} video={project.video} alt={`${project.title} project preview`} />
        </div>
      </div>
    </div>
  </div>
</section>
