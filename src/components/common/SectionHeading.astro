---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: "start" | "center";
}

const { eyebrow, title, description, align = "start" } = Astro.props;
---

<div class:list={["section-heading reveal reveal-up", align === "center" && "text-center mx-auto"]}>
  <p class="eyebrow">{eyebrow}</p>
  <h2>{title}</h2>
  {description && <p>{description}</p>}
</div>
