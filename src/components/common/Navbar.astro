---
import { siteConfig } from "@/data/site";
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header" data-site-header>
  <nav class="navbar navbar-expand-lg" aria-label="Primary navigation">
    <div class="container">
      <a class="navbar-brand" href="/">{siteConfig.name}</a>
      <button class="nav-toggle" type="button" aria-controls="primary-nav" aria-expanded="false" data-nav-toggle>
        <span></span>
        <span></span>
        <span></span>
      </button>
      <div class="nav-backdrop" data-nav-backdrop></div>
      <div class="nav-panel" id="primary-nav" data-nav-panel aria-label="Primary navigation links">
        <button class="nav-close" type="button" aria-label="Close navigation" data-nav-close>
          <span></span>
          <span></span>
        </button>
        <a href="/">Home</a>
        <a href="/#works">Works</a>
        <a href="/#skills">Skills</a>
        <a href="/#contact">Contact</a>
      </div>
    </div>
  </nav>
